# KRIDA Environment Configuration

# Security
SECRET_KEY=krida_super_secret_production_key_replace_with_secure_random_string

# Database (Default: local SQLite database, or supply PostgreSQL connection string)
DATABASE_URL=sqlite:///./krida.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/krida_db

# AI Provider (Optional: leave blank to automatically use built-in local sports-science AI)
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=auto
